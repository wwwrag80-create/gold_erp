# ══════════════════════════════════════════════════════════════
# اعدادات الاتصال السحابي - نظام جاديت
# انسخ هذا الملف باسم .env ثم ضع قيمك
# انتبه للاملاء: SUPABASE  (وليس SUPBASE)
# ══════════════════════════════════════════════════════════════

SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# مفتاح الخدمة - لنسختك انت فقط (لانشاء حسابات المصانع)
SUPABASE_SERVICE_KEY=sb_secret_xxxxxxxx

# بيانات القاعدة المباشرة - لا توزعها مع المصانع
SUPABASE_DB_HOST=db.xxxxxxxx.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=
